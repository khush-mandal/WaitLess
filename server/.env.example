# Server
PORT=5000
NODE_ENV=development

# Frontend origin(s) allowed by CORS (comma-separated)
CLIENT_URL=http://localhost:5173

# Supabase PostgreSQL (server-side only — never expose to React)
# From Supabase: Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase requires SSL for direct connections
DATABASE_SSL=true
